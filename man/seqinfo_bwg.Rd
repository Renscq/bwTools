\name{seqinfo_bwg}
\alias{seqinfo_bwg}
\title{Read signal-track chromosome metadata}
\usage{seqinfo_bwg(x)}
\arguments{\item{x}{A local BigWig file path or BwgTrack-compatible object.}}
\value{A \code{data.table} containing chromosome metadata.}
\description{Returns chromosome names and lengths when available.}
