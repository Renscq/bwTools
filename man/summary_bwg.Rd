\name{summary_bwg}
\alias{summary_bwg}
\title{Summarize a BwgTrack-compatible object}
\usage{summary_bwg(object)}
\arguments{\item{object}{A BwgTrack-compatible object.}}
\value{A named list with sample, interval, chromosome, coordinate, and backend information.}
\description{Returns compact object-level signal-track metadata.}
